PORT=2091
APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=trust_management_db
JWT_SECRET=your_jwt_secret_key
DEVICE_JWT_SECRET=your_device_jwt_secret_key
TIMEZONE=Asia/Kolkata
FRONTEND_URL=http://localhost:5173
# Comma-separated list of additional allowed CORS origins (FRONTEND_URL is always
# allowed automatically). Defaults to the common local-dev origins if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# GoDaddy-hosted mailbox used by internal/mail to send outbound email
# (implicit TLS / SMTPS on port 465 — see the mailbox's "Secure SSL/TLS Settings").
SMTP_HOST=mail.arminfo.in
SMTP_PORT=465
SMTP_USERNAME=noreply@arminfo.in
SMTP_PASSWORD=your_mailbox_password
SMTP_FROM_ADDRESS=noreply@arminfo.in

# ARMSS Gateway installer OTP gate: the installer POSTs to /api/v1/installer/*
# with this shared secret in an X-Installer-Secret header, and the resulting
# OTP is emailed to this admin address for the installing user to request by
# phone/chat.
INSTALLER_ADMIN_EMAIL=admin@arminfo.in
INSTALLER_API_SECRET=your_installer_shared_secret

# Payment Gateways (Razorpay & Cashfree)
razerpay_apikey=rzp_test_your_key_id
razerpay_secret=your_key_secret
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=production

